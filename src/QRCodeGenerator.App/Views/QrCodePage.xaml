<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRCodeGenerator.App.Views.QrCodePage"
             Title="QR Code Generator">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="Enter the QR Code content:"
                   FontSize="16"
                   FontAttributes="Bold" />

            <Entry x:Name="ContentEntry"
                   Placeholder="Type up to 100 characters..."
                   MaxLength="100" />

            <Grid ColumnDefinitions="*, *" 
                  ColumnSpacing="10" 
                  HorizontalOptions="Center" 
                  WidthRequest="320">

                <Button Grid.Column="0"
                        Text="Generate"
                        Clicked="OnGenerateClicked"
                        BackgroundColor="#00CD00"
                        TextColor="#FFFFFF"
                        HeightRequest="45"
                        ContentLayout="Left, 8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="✓" Color="#FFFFFF" Size="16" />
                    </Button.ImageSource>
                </Button>

                <Button Grid.Column="1"
                        Text="Clear"
                        Clicked="OnClearClicked"
                        BackgroundColor="#DC3545"
                        TextColor="#FFFFFF"
                        HeightRequest="45"
                        ContentLayout="Left, 8">
                    <Button.ImageSource>
                        <FontImageSource Glyph="✕" Color="#FFFFFF" Size="16" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#00CD00" />

            <Border Stroke="#CCCCCC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10"
                    HeightRequest="250"
                    WidthRequest="250"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Image x:Name="QrCodeImage"
                       Aspect="AspectFit"
                       HeightRequest="230"
                       WidthRequest="230" />
            </Border>

            <Button x:Name="DownloadButton"
                    Text="Download QR Code"
                    Clicked="OnDownloadClicked"
                    BackgroundColor="#007BFF"
                    TextColor="#FFFFFF"
                    HeightRequest="45"
                    ContentLayout="Left, 8"
                    IsVisible="False"
                    HorizontalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource Glyph="↓" Color="#FFFFFF" Size="16" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>